data: {"code":0,"message":"","data":null,"sentence":{"phonemes":[],"text":"树枝在林中互相碰触着，绿叶在狂风里簌簌地响，雷云拍着大手。这时，花孩子们便穿了紫的、黄的、白的衣裳，冲了出来。","words":[]}}

