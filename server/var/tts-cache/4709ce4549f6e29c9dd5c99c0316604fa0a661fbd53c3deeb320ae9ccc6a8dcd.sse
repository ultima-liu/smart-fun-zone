data: {"code":0,"message":"","data":null,"sentence":{"phonemes":[],"text":"丁香花，开满树，白的潇洒紫的朦胧； 小花苞，圆鼓鼓，像那衣襟盘花扣； 人生结，解不完，平平淡淡才无味。","words":[]}}

