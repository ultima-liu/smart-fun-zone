# 聪明乐园服务端环境变量示例（复制为 server/.env）
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=仅开发可临时使用-生产请替换为至少32位随机值
SMS_MOCK_CODE=123456
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
CORS_ORIGINS=http://localhost:5173

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=sfz123456
MYSQL_DB=smart_fun_zone

# 火山语音合成密钥（服务端注入，不暴露给前端）
VOLC_SPEECH_API_KEY=

# 学习助手「小卷」LLM（OpenAI 兼容接口，服务端注入）
# baseUrl 填到 /v1（如 https://api.openai.com/v1 或兼容服务），model 填模型名
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=

# 短信提供商：mock（默认，固定码 123456）| aliyun（真实短信）
SMS_PROVIDER=mock
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 课程 AI 确认（未设置时沿用 CHAT_*；录音模型须支持原始音频输入）
# 要独立配置时填写以下变量；音频可选择不同的模型/提供商。
# COURSE_AI_BASE_URL=https://your-provider.example/v1
# COURSE_AI_MODEL=your-text-model
# COURSE_AI_API_KEY=your-key
# COURSE_AI_AUDIO_BASE_URL=https://your-provider.example/v1
# COURSE_AI_AUDIO_MODEL=your-audio-model
# COURSE_AI_AUDIO_API_KEY=your-key
# COURSE_AI_ASSET_DIR=/absolute/path/to/public-or-dist

# 英语固定词句跟读：本地 SenseVoiceSmall + Silero VAD，无外部 ASR API 密钥。
# 首次安装：npm --prefix server run setup:reading-asr（Python 3.12+，模型约240MB）
# 不设置时使用 server/var/reading-asr 下的隔离 Python 环境与模型。
# READING_ASR_PYTHON=/absolute/path/to/python
# READING_ASR_MODEL_DIR=/absolute/path/to/sense-voice
