# 聪明乐园服务端环境变量示例（复制为 server/.env）
PORT=8787
HOST=0.0.0.0
JWT_SECRET=change-me-in-production
SMS_MOCK_CODE=123456

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=sfz123456
MYSQL_DB=smart_fun_zone

# 火山语音合成密钥（服务端注入，不暴露给前端）
VOLC_SPEECH_API_KEY=

# 学习助手「小卷」LLM（OpenAI 兼容接口，服务端注入）
# baseUrl 填到 /v1（如 https://api.openai.com/v1 或兼容服务），model 填模型名
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=

# 短信提供商：mock（默认，固定码 123456）| aliyun（真实短信）
SMS_PROVIDER=mock
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
