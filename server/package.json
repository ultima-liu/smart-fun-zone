{
  "name": "smart-fun-zone-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "聪明乐园服务端：账号/家庭、内容包下发、同步、计划、周报、TTS 代理、跟读评测（Fastify + MySQL）",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "db:init": "tsx src/db-init.ts",
    "seed": "tsx src/seed-content.ts",
    "smoke": "tsx scripts/smoke.mts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
