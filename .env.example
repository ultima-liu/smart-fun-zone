# 复制本文件为 .env.local 并填入你的火山引擎语音 API Key
# 获取地址：https://console.volcengine.com/speech/new/setting/apikeys
# 密钥由 Vite dev/preview 代理在服务端注入（不带 VITE_ 前缀，不会打进前端包）
VOLC_SPEECH_API_KEY=

# 可选：自定义音色（默认 中文=爽快思思 zh_female_shuangkuaisisi_uranus_bigtts，
#       英文=Dacey en_female_dacey_uranus_bigtts）
# 常用 2.0 音色：zh_female_vv_uranus_bigtts / zh_female_cancan_uranus_bigtts /
#   zh_female_tianmeixiaoyuan_uranus_bigtts / zh_female_xiaohe_uranus_bigtts /
#   zh_male_m191_uranus_bigtts / en_female_dacey_uranus_bigtts / en_male_tim_uranus_bigtts
# VITE_VOLC_SPEAKER_ZH=zh_female_shuangkuaisisi_uranus_bigtts
# VITE_VOLC_SPEAKER_EN=en_female_dacey_uranus_bigtts
