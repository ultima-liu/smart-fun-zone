{
  "name": "smart-fun-zone",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "聪明乐园 Smart Fun Zone — 幼儿智力训练小游戏网站（商业级品质版）",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run check:bundle",
    "preview": "vite preview",
    "lint": "eslint src e2e server/src",
    "lint:fix": "eslint src e2e server/src --fix",
    "format": "prettier --write src e2e server/src",
    "test": "vitest run",
    "test:server": "npm --prefix server test",
    "test:e2e": "playwright test",
    "test:e2e:math": "playwright test e2e/math-*.spec.ts e2e/math-textbook-lab.spec.ts e2e/fruit-shop.spec.ts",
    "test:e2e:chinese": "playwright test e2e/chinese-textbook.spec.ts",
    "test:e2e:english": "playwright test e2e/english-textbook.spec.ts",
    "test:e2e:park": "playwright test e2e/park-arcade.spec.ts",
    "test:e2e:story": "playwright test e2e/home-story-strip.spec.ts e2e/story-npc-card-reward.spec.ts e2e/archive-npc-reset.spec.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run lint && npm run test && npm run test:server && npm run build && npm --prefix server run build",
    "gen:words": "esbuild scripts/gen-text-words.ts --bundle --platform=node --format=esm --outfile=scripts/_gen.mjs && node scripts/_gen.mjs"
  },
  "dependencies": {
    "hanzi-writer": "^3.7.3",
    "pinyin-pro": "^3.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "segmentit": "^2.0.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
